#!/bin/sh
# CR8809 自定义固件首次启动默认值
# 定位：有线单臂旁路由（192.168.2.20），网关与 PPPoE 交给中兴主路由 192.168.2.1，
#       代理由 PVE 上的 mihomo（192.168.2.7）提供，失联时自动降级为直连。

uci -q set system.@system[0].hostname='CR8809'
uci -q set system.@system[0].timezone='CST-8'
uci -q set system.@system[0].zonename='Asia/Shanghai'
uci -q commit system

uci -q set luci.main.lang='zh_cn'
uci -q set luci.themes.Argon='/luci-static/argon'
uci -q set luci.main.mediaurlbase='/luci-static/argon'
uci -q commit luci

# --- 单臂旁路由：LAN 192.168.2.20/24，默认路由交给中兴 .1 ---
uci -q set network.lan.ipaddr='192.168.2.20'
uci -q set network.lan.netmask='255.255.255.0'
uci -q set network.lan.gateway='192.168.2.1'
uci -q commit network

# --- 单臂转发：masq（回程对称）+ 硬件流量卸载 ---
uci -q set firewall.@zone[0].masq='1'
uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='1'
uci -q commit firewall

# --- DNS 上游指向 PVE mihomo；关闭 rebind 保护以接受 fake-ip（198.18.0.0/15）---
uci -q set dhcp.@dnsmasq[0].noresolv='1'
uci -q delete dhcp.@dnsmasq[0].server
uci -q add_list dhcp.@dnsmasq[0].server='192.168.2.7'
uci -q set dhcp.@dnsmasq[0].rebind_protection='0'
uci -q commit dhcp

# --- DHCP 已配置但待命：全屋接管时把 ignore 改为 0 ---
uci -q set dhcp.lan.ignore='1'
uci -q set dhcp.lan.start='100'
uci -q set dhcp.lan.limit='100'
uci -q set dhcp.lan.leasetime='12h'
uci -q set dhcp.lan.dhcpv4='server'
uci -q set dhcp.lan.ra='disabled'
uci -q set dhcp.lan.dhcpv6='disabled'
uci -q delete dhcp.lan.dhcp_option
uci -q add_list dhcp.lan.dhcp_option='3,192.168.2.20'
uci -q add_list dhcp.lan.dhcp_option='6,192.168.2.20'
uci -q commit dhcp

# --- 关闭无线射频（保留驱动与固件，需要时在 LuCI 里启用）---
for r in $(uci -q show wireless | grep -oE 'wireless\.radio[0-9]+' | cut -d. -f2 | sort -u); do
    uci -q set wireless.$r.disabled='1'
done
uci -q commit wireless

# --- 启用 DNS 降级守护（PVE 失联自动切直连）---
/etc/init.d/dns-failover enable
/etc/init.d/dns-failover start

exit 0
