#!/bin/sh /etc/rc.common
# 常驻守护：每 10 秒执行一次降级检查
USE_PROCD=1
START=99
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh -c 'while true; do /usr/bin/dns-failover.sh; sleep 10; done'
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
