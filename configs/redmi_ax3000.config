# CR8809 A版（mp02.1 / Redmi AX3000 兼容）构建配置
#
# 定位：有线单臂旁路由（DNS + 转发），代理由 PVE 上的 mihomo 提供。
# 因此**不打包**任何代理内核（Xray / OpenClash / PassWall）与广告过滤组件。
# 保留 WiFi 能力，但首次启动默认关闭射频。

CONFIG_TARGET_ipq50xx=y
CONFIG_TARGET_ipq50xx_arm=y
CONFIG_TARGET_ipq50xx_arm_DEVICE_redmi_ax3000=y

CONFIG_CCACHE=y

# U-Boot Web 恢复实际上限约 14 MiB（实测：14.38 MiB 被拒，已知可用镜像为 11/14 MiB）。
# 1 MB 块让 xz 压缩率更好，配合下方的裁剪把镜像压到 14 MiB 以内。
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024

# dnsmasq-full：DNS + DHCP 核心；必须关闭基础 dnsmasq，否则打包冲突
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# LuCI 基础
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

# 主题：只保留 Argon（Aurora / Bootstrap 已移除）
CONFIG_PACKAGE_luci-theme-argon=y

# 简体中文
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# 转发性能：nft flow offload + BBR
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# 命令行工具（SSH 可完成其余操作，不再内置 ttyd / commands / htop / nano / curl）
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_zoneinfo-asia=y

# PPPoE 由中兴主路由负责，本机只做旁路由，不需要 ppp/pppoe
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_luci-proto-ppp is not set
